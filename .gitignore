# Planilla fuente de la liga: contiene datos de jugadores reales.
# El pipeline la lee localmente; no se versiona.
*.xlsx
~$*.xlsx

# Config local de Claude Code (preferencias de esta máquina)
.claude/settings.local.json

# Artefactos del SO
Thumbs.db
Desktop.ini
.DS_Store
*.xlsx
__pycache__/
.venv/

# Reporte de paipus propuestos: se regenera en cada corrida.
reports/

# Preview local: dependencias de build y bundles generados.
.vendor/
dist/

# Build de producción (lo genera Vercel en cada deploy).
dist-site/
.vercel/

# El package.json de la raíz no declara dependencias; esto es sólo el rastro
# que deja npm si alguien corre npm install igual.
node_modules/
package-lock.json
